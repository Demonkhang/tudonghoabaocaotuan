# ==========================================
# CẤU HÌNH CƠ SỞ DỮ LIỆU NEON (POSTGRESQL)
# ==========================================
# Lấy từ dashboard https://neon.tech (chọn tab Pooled connection)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz-123-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ==========================================
# CẤU HÌNH LƯU TRỮ CLOUDINARY (FILE UPLOADS)
# ==========================================
# Lấy từ dashboard https://cloudinary.com (mục API Keys)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Hoặc dùng chuỗi kết nối đầy đủ:
# CLOUDINARY_URL="cloudinary://your_api_key:your_api_secret@your_cloud_name"

# ==========================================
# CẤU HÌNH ỨNG DỤNG KHÁC
# ==========================================
NODE_ENV="production"
PORT=3000
GEMINI_API_KEY="your_gemini_api_key"
APP_URL="https://your-app.vercel.app"
